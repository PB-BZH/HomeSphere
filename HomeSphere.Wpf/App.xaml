<Application x:Class="HomeSphere.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HomeSphere.Wpf"
             StartupUri="Views/MainWindow.xaml"
             xmlns:conv="clr-namespace:HomeSphere.Wpf.Converters">  
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:RoomImageConverter x:Key="RoomImageConverter" />
            <conv:EquipmentImageConverter x:Key="EquipmentImageConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:EquipmentActiveConverter x:Key="EquipmentActiveConverter" />
            <conv:TemperatureColorConverter x:Key="TemperatureColorConverter" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
