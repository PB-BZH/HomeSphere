<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Couleurs de texte -->
    <SolidColorBrush x:Key="TextPrimaryBrush"
                     Color="#F3F4F6" />

    <SolidColorBrush x:Key="TextSecondaryBrush"
                     Color="#9CA3AF" />

    <SolidColorBrush x:Key="AccentBrush"
                     Color="#3B82F6" />

    <SolidColorBrush x:Key="Accent2Brush"
                     Color="#344256" />

    <SolidColorBrush x:Key="PanelBrush"
                     Color="#1F2937" />

    <SolidColorBrush x:Key="PanelSecondaryBrush"
                     Color="#182230" />

    <SolidColorBrush x:Key="PanelBorderBrush"
                     Color="#374151" />
</ResourceDictionary>