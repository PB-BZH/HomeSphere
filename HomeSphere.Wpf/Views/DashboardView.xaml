<UserControl x:Class="HomeSphere.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HomeSphere.Wpf.Views"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                CornerRadius="8"
                Padding="14"
                Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Tableau de bord"
                           Grid.Row="0"
                           HorizontalAlignment="Left"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Maison principale - vue d'ensemble"
                           Grid.Row="1"
                           Style="{StaticResource SectionSecondaryTitleStyle}" />

                <TextBlock Text="Supervision"
                           Grid.Row="0"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           Style="{StaticResource SectionTitleStyle}"
                           FontSize="14" />
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        CornerRadius="8"
                        Padding="14"
                        Margin="10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Pièces"
                                   Style="{StaticResource SectionSecondaryTitleStyle}" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding NombrePieces}"
                                   Style="{StaticResource SectionValueStyle}" />
                    </Grid>
                </Border>
                <Border Grid.Column="2"
                        Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        CornerRadius="8"
                        Padding="14"
                        Margin="10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Équipements"
                                   Style="{StaticResource SectionSecondaryTitleStyle}" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding NombreEquipements}"
                                   Style="{StaticResource SectionValueStyle}" />
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="2"
                  Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        CornerRadius="8"
                        Padding="14"
                        Margin="10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Allumés"
                                   Style="{StaticResource SectionSecondaryTitleStyle}" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding NombreEquipementsAllumes}"
                                   Style="{StaticResource SectionValueStyle}" />
                    </Grid>
                </Border>
                <Border Grid.Column="2"
                        Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        CornerRadius="8"
                        Padding="14"
                        Margin="10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Connectés"
                                   Style="{StaticResource SectionSecondaryTitleStyle}" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding NombreEquipementsConnectes}"
                                   Style="{StaticResource SectionValueStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="4">
            <Grid Grid.Row="0"
                  Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Grid.Row="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        CornerRadius="8"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Température par pièce"
                                   Grid.Row="0"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Orientation="Vertical">
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                    CornerRadius="8"
                                    Padding="14">
                                <ItemsControl ItemsSource="{Binding TemperaturesPieces}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PanelSecondaryBrush}"
                                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                                    CornerRadius="8"
                                                    Padding="14"
                                                    Margin="0,10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="0"
                                                               Text="{Binding Piece.Nom}"
                                                               Style="{StaticResource SectionTitleStyle}"
                                                               Margin="10,0" />

                                                    <TextBlock Grid.Row="0"
                                                               Grid.Column="1"
                                                               Text="{Binding Thermometre.Temperature, StringFormat={}{0:F1} °C}"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0" />

                                                    <ProgressBar Grid.Row="1"
                                                                 Grid.ColumnSpan="2"
                                                                 Minimum="15"
                                                                 Maximum="25"
                                                                 Value="{Binding Thermometre.Temperature}"
                                                                 Height="8"
                                                                 Margin="10,8"
                                                                 Foreground="{Binding Thermometre.Temperature, Converter={StaticResource TemperatureColorConverter}}"
                                                                 Background="{StaticResource PanelBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="6">
            <Grid Grid.Row="0"
                  Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        CornerRadius="8"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Simulation des températures"
                                   Grid.Row="0"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Actualisation toutes les 10 secondes"
                                   Grid.Row="1"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource SectionSecondaryTitleStyle}" />
                        <TextBlock Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Grid.Column="2"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"
                                            Value="Simulation désactivée" />
                                    <Setter Property="Foreground"
                                            Value="LightSalmon" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SimulationActive}"
                                                     Value="True">
                                            <Setter Property="Text"
                                                    Value="Simulation activée" />
                                            <Setter Property="Foreground"
                                                    Value="LightGreen" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
