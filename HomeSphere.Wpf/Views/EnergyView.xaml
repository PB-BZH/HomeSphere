<UserControl x:Class="HomeSphere.Wpf.Views.EnergyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HomeSphere.Wpf.Views">
    <Grid Background="{StaticResource PanelSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Conteneur général -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                CornerRadius="12"
                Margin="10"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Bilan énergétique"
                               Style="{StaticResource SectionTitleStyle}"
                               VerticalAlignment="Center" />

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBorderBrush}"
                            CornerRadius="12"
                            Margin="10"
                            Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Puissance totale : "
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding PuissanceTotale, StringFormat={}{0:F0} W}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="2">
                    <Border Background="{StaticResource PanelBorderBrush}"
                            CornerRadius="12"
                            Margin="10"
                            Padding="14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Puissance par pièce : "
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,0,10,0" />

                            <ItemsControl ItemsSource="{Binding PuissancesParPiece_ParNom_W}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Key}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value, StringFormat={}{0:F0} W}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="4">
                    <Border Background="{StaticResource PanelBorderBrush}"
                            CornerRadius="12"
                            Margin="10"
                            Padding="14">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Consommation : "
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Margin="0,0,10,0" />

                                <TextBlock Text="{Binding EnergieTotaleKWh, StringFormat={}{0:F4} kWh}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Margin="10,0,0,0" />
                            </StackPanel>


                            <ItemsControl ItemsSource="{Binding EnergieParPiece_ParNom_kWh}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Key}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value, StringFormat={}{0:F4} kWh}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="6">
                    <Border Background="{StaticResource PanelBorderBrush}"
                            CornerRadius="12"
                            Margin="10"
                            Padding="14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Durée d'observation de la consommation : "
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,0,10,0" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="durée globale    : "
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DureeObservationGlobale, StringFormat={}{0:F2} heures}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="durée par pièce : "
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DureeObservationParPiece, StringFormat={}{0:F2} heures}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Margin="10,0,0,0" />
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
