<UserControl x:Class="HomeSphere.Wpf.Views.EnergyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HomeSphere.Wpf.Views">
    <Grid Background="{StaticResource PanelSecondaryBrush}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="Gestion énergétique"
                       Style="{StaticResource SectionTitleStyle}" />

            <TextBlock Text="Salon - Cuisine - Chambre - Bureau"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />

        </StackPanel>
    </Grid>
</UserControl>
