<UserControl x:Class="HomeSphere.Wpf.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:local="clr-namespace:HomeSphere.Wpf.Views">
    <Grid Background="{StaticResource PanelSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.6*" />
            <RowDefinition Height="0.6*" />
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="0.8*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Historique énergétique"
                   Style="{StaticResource SectionTitleStyle}"
                   Margin="10" />
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    Margin="10">

            <TextBlock Text="Du :"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,8,0" />

            <DatePicker SelectedDate="{Binding DateDebut, Mode=TwoWay}"
                        Width="140"
                        Margin="0,0,20,0" />

            <TextBlock Text="Au :"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,8,0" />

            <DatePicker SelectedDate="{Binding DateFin, Mode=TwoWay}"
                        Width="140" />

            <TextBlock Text="Consommation :"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="30,0,8,0" />

            <TextBlock Text="{Binding ConsommationPeriode_kWh, StringFormat={}{0:F4} kWh, TargetNullValue=Données indisponibles}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
        </StackPanel>
        <DockPanel Grid.Row="2">

            <TextBlock Text="Relevés énergétiques"
                       DockPanel.Dock="Top"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="10,5,0,5" />
            <DataGrid ItemsSource="{Binding RelevesFiltres}"
                      AutoGenerateColumns="False"
                      Background="{StaticResource PanelBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      RowBackground="{StaticResource PanelBrush}"
                      AlternatingRowBackground="{StaticResource PanelSecondaryBrush}"
                      AlternationCount="2"
                      VerticalScrollBarVisibility="Auto">

                <!-- Tes trois colonnes existantes restent ici -->

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="{StaticResource PanelSecondaryBrush}" />
                        <Setter Property="Foreground"
                                Value="{StaticResource TextPrimaryBrush}" />
                        <Setter Property="BorderBrush"
                                Value="{StaticResource PanelBorderBrush}" />
                        <Setter Property="Padding"
                                Value="10,8" />
                        <Setter Property="FontWeight"
                                Value="Bold" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date et heure"
                                        Binding="{Binding Horodatage, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                                        Width="*" />

                    <DataGridTextColumn Header="Puissance (W)"
                                        Binding="{Binding PuissanceTotale_W, StringFormat={}{0:N0}}"
                                        Width="*" />

                    <DataGridTextColumn Header="Énergie cumulée (kWh)"
                                        Binding="{Binding EnergieTotaleConsommee_kWh, StringFormat={}{0:N4}}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <DockPanel Grid.Row="3">

            <TextBlock Text="Consommations par intervalle"
                       DockPanel.Dock="Top"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="10,5,0,5" />
            <DataGrid ItemsSource="{Binding ConsommationsParIntervalleFiltrees}"
                      AutoGenerateColumns="False"
                      Background="{StaticResource PanelBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      RowBackground="{StaticResource PanelBrush}"
                      AlternatingRowBackground="{StaticResource PanelSecondaryBrush}"
                      AlternationCount="2"
                      VerticalScrollBarVisibility="Auto">

                <!-- Tes trois colonnes existantes restent ici -->

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="{StaticResource PanelSecondaryBrush}" />
                        <Setter Property="Foreground"
                                Value="{StaticResource TextPrimaryBrush}" />
                        <Setter Property="BorderBrush"
                                Value="{StaticResource PanelBorderBrush}" />
                        <Setter Property="Padding"
                                Value="10,8" />
                        <Setter Property="FontWeight"
                                Value="Bold" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Début"
                                        Binding="{Binding Debut, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                                        Width="*" />

                    <DataGridTextColumn Header="Fin"
                                        Binding="{Binding Fin, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                                        Width="*" />

                    <DataGridTextColumn Header="Consommation de l'intervalle (kWh)"
                                        Binding="{Binding EnergieConsommee_kWh, StringFormat={}{0:N4}}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <DockPanel Grid.Row="4">

            <TextBlock Text="Consommations journalieres"
                       DockPanel.Dock="Top"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="10,5,0,5" />
            <DataGrid ItemsSource="{Binding ConsommationsJournalieres}"
                      AutoGenerateColumns="False"
                      Background="{StaticResource PanelBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      RowBackground="{StaticResource PanelBrush}"
                      AlternatingRowBackground="{StaticResource PanelSecondaryBrush}"
                      AlternationCount="2"
                      VerticalScrollBarVisibility="Auto">

                <!-- Tes trois colonnes existantes restent ici -->

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="{StaticResource PanelSecondaryBrush}" />
                        <Setter Property="Foreground"
                                Value="{StaticResource TextPrimaryBrush}" />
                        <Setter Property="BorderBrush"
                                Value="{StaticResource PanelBorderBrush}" />
                        <Setter Property="Padding"
                                Value="10,8" />
                        <Setter Property="FontWeight"
                                Value="Bold" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}"
                                        Width="*" />

                    <DataGridTextColumn Header="Énergie consommée (kWh)"
                                        Binding="{Binding ConsommationJournaliere_kWh, StringFormat={}{0:N4}}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#64748B"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,5,0"
                    Padding="5">

                <DockPanel>
                    <TextBlock Text="Évolution de la puissance"
                               DockPanel.Dock="Top"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="10,5,0,5" />

                    <lvc:CartesianChart Series="{Binding Series}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        Grid.Column="0"
                                        Background="{StaticResource PanelBrush}" />
                </DockPanel>
            </Border>
            <Border Grid.Column="1"
                    BorderBrush="#64748B"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,5,0"
                    Padding="5">

                <TabControl Background="Transparent"
                            BorderThickness="0">

                    <TabItem Header="Jour">
                        <DockPanel Grid.Row="1">

                            <TextBlock Text="Consommations journalières"
                                       DockPanel.Dock="Top"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="10,5,0,5" />


                            <lvc:CartesianChart Grid.Column="1"
                                                Series="{Binding SeriesJournalieres}"
                                                XAxes="{Binding XAxesJournalieres}"
                                                Background="{StaticResource PanelBrush}"
                                                YAxes="{Binding YAxesJournalieres}" />

                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Semaine">
                        <DockPanel Grid.Row="1">

                            <TextBlock Text="Consommations hebdomadaires"
                                       DockPanel.Dock="Top"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="10,5,0,5" />


                            <lvc:CartesianChart Series="{Binding SeriesHebdomadaires}"
                                                XAxes="{Binding XAxesHebdomadaires}"
                                                YAxes="{Binding YAxesHebdomadaires}"
                                                Background="{StaticResource PanelBrush}" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Mois">
                        <DockPanel Grid.Row="1">

                            <TextBlock Text="Consommations mensuelles"
                                       DockPanel.Dock="Top"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="10,5,0,5" />


                            <lvc:CartesianChart Grid.Column="1"
                                                Series="{Binding SeriesMensuelles}"
                                                XAxes="{Binding XAxesMensuelles}"
                                                Background="{StaticResource PanelBrush}"
                                                YAxes="{Binding YAxesMensuelles}" />

                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
