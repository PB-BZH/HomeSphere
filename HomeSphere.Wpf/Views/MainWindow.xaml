<Window x:Class="HomeSphere.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomeSphere.Wpf.Views"
        xmlns:views="clr-namespace:HomeSphere.Wpf.Views"
        xmlns:vm="clr-namespace:HomeSphere.Wpf.ViewModels"
        Background="#111827"
        mc:Ignorable="d"
        Title="HomeSphere Studio"
        MinHeight="700"
        MinWidth="1100">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RoomsViewModel}">
            <views:RoomsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EquipmentsViewModel}">
            <views:EquipmentsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ScenarioViewModel}">
            <views:ScenarioView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EnergyViewModel}">
            <views:EnergyView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ParametersViewModel}">
            <views:ParametersView />
        </DataTemplate>
    </Window.Resources>
    
    <!-- ============================================================
        2. ZONE PRINCIPALE
        Menus à gauche / Panneau de visualisation à droite
        ============================================================ -->

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <!-- Analyse -->
            <ColumnDefinition Width="310" />
            <!-- Séparation -->
            <ColumnDefinition Width="14" />
            <!-- Annonce -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!-- ========================================================
         2A. PANNEAU DE MENUS
         ======================================================== -->

        <Border Grid.Column="0"
                Background="{StaticResource PanelSecondaryBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                CornerRadius="8"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Titre -->
                <Border Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">

                    <TextBlock Text="HomeSphere"
                               Style="{StaticResource SectionTitleStyle}" />
                </Border>

                <!-- Tableau de bord -->
                <Border Grid.Row="2"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="8"
                        Margin="0,0,0,8">

                    <Button Content="Tableau de bord"
                            Tag="Dashboard"
                            Command="{Binding AfficherDashboardCommand}"
                            Style="{StaticResource NavigationButtonStyle}" />
                </Border>
                <!-- Pièces -->
                <Border Grid.Row="3"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="8"
                        Margin="0,0,0,8">

                    <Button Content="Pièces"
                            Tag="Rooms"
                            Command="{Binding AfficherPiecesCommand}"
                            Style="{StaticResource NavigationButtonStyle}" />
                </Border>
                
                <!-- Équipements -->
                <Border Grid.Row="4"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="8"
                        Margin="0,0,0,8">

                    <Button Content="Équipements"
                            Tag="Equipments"
                            Command="{Binding AfficherEquipementsCommand}"
                            Style="{StaticResource NavigationButtonStyle}" />
                </Border>

                <!-- Scénarios -->
                <Border Grid.Row="5"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="8"
                        Margin="0,0,0,8">

                    <Button Content="Scénarios"
                            Tag="Scenario"
                            Command="{Binding AfficherScenarioCommand}"
                            Style="{StaticResource NavigationButtonStyle}" />
                </Border>

                <!-- Énergie -->
                <Border Grid.Row="6"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="8"
                        Margin="0,0,0,8">

                    <Button Content="Énergie"
                            Tag="Energy"
                            Command="{Binding AfficherEnergieCommand}"
                            Style="{StaticResource NavigationButtonStyle}" />
                </Border>

                <!-- Historique -->
                <Border Grid.Row="7"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="8"
                        Margin="0,0,0,8">

                    <Button Content="Historique"
                            Tag="History"
                            Command="{Binding AfficherHistoriqueCommand}"
                            Style="{StaticResource NavigationButtonStyle}" />
                </Border>

                <!-- Paramètres en bas -->
                <Border Grid.Row="9"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="8"
                        Margin="0,0,0,8">

                    <Button Content="Paramètres"
                            Tag="Parameters"
                            Command="{Binding AfficherParametresCommand}"
                            Style="{StaticResource NavigationButtonStyle}" />
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================
             2B. PANNEAU Principal
             ======================================================== -->
        <ContentControl Grid.Column="2"
                        Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
