<UserControl x:Class="HomeSphere.Wpf.Views.ParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HomeSphere.Wpf.Views">
    <Grid Background="{StaticResource PanelSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Paramètres"
                       Grid.Column="0"
                       Style="{StaticResource SectionTitleStyle}"
                       VerticalAlignment="Center" />
            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Margin="0,0,0,8">
                <TextBlock Text="Simulation"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>
        </Grid>
        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Tag="{Binding}"
                    Margin="10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image Source="/Images/thermometre.png"
                           Grid.Column="0"
                           Width="48"
                           Height="48"
                           Stretch="Uniform"
                           Margin="0,0,0,10" />
                    <StackPanel Grid.Column="2"
                                Orientation="Vertical">
                        <TextBlock Text="Simulation des températures"
                                   Style="{StaticResource SectionTitleStyle}"
                                   HorizontalAlignment="Left" />

                        <TextBlock Text="Actualisation automatique des capteurs virtuels"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- doit devenir rouge si éteint -->
                    <Button Grid.Column="3"
                            Command="{Binding BasculerSimulationCommand}"
                            Width="50"
                            Height="30"
                            Cursor="Hand"
                            BorderThickness="0"
                            Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Fond"
                                        Background="Green"
                                        CornerRadius="15">

                                    <Ellipse x:Name="Commutateur"
                                             Width="30"
                                             Height="30"
                                             HorizontalAlignment="Left"
                                             Fill="LightGray" />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding SimulationActive}"
                                                 Value="False">
                                        <Setter TargetName="Fond"
                                                Property="Background"
                                                Value="Red" />
                                        <Setter TargetName="Commutateur"
                                                Property="HorizontalAlignment"
                                                Value="Right" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Left"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Grid.Column="0">
                        <TextBlock Text="Etat de la simulation"
                                   Margin="0,10"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Intervalle d'actualisation"
                                   Margin="0,10"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center"
                                Grid.Row="1"
                                Grid.Column="3">
                        <TextBlock FontSize="14"
                                   Margin="0,10"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text"
                                            Value="En cours" />
                                    <Setter Property="Foreground"
                                            Value="LightGreen" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SimulationActive}"
                                                     Value="False">
                                            <Setter Property="Text"
                                                    Value="Arrêtée" />
                                            <Setter Property="Foreground"
                                                    Value="LightCoral" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="10 secondes"
                                   HorizontalAlignment="Center"
                                   Margin="0,10"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
