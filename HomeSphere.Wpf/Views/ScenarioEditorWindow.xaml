<Window x:Class="HomeSphere.Wpf.Views.ScenarioEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau scénario"
        Height="700"
        Width="1112"
        Background="{StaticResource PanelSecondaryBrush}">

    <Grid Background="{StaticResource PanelSecondaryBrush}"
          Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="1" />
            <RowDefinition Height="20" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!--Partie Gauche-->
        <Border Grid.Row="0"
                CornerRadius="8"
                Padding="12"
                Background="{StaticResource PanelBorderBrush}">
            <!-- Titre -->
            <TextBlock Grid.Row="0"
                       Text="Nouveau scénario"
                       Style="{StaticResource SectionTitleStyle}" />
        </Border>

        <!-- Séparateur -->
        <Border Grid.Row="2"
                CornerRadius="5"
                Background="{StaticResource PanelBorderBrush}" />

        <!-- Formulaire -->
        <Border Grid.Row="4"
                CornerRadius="8"
                Padding="14"
                Background="{StaticResource PanelBorderBrush}">
            <StackPanel Grid.Row="4">
                <TextBlock Text="Nom du scénario"
                           Style="{StaticResource SectionSecondaryTitleStyle}"
                           Margin="0,0,0,8" />

                <TextBox x:Name="txtNomScenario"
                         Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"
                         Height="32"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Background="{StaticResource PanelBorderBrush}"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,20" />

                <TextBlock Text="Description du scénario"
                           Style="{StaticResource SectionSecondaryTitleStyle}"
                           Margin="0,0,0,8" />

                <TextBox x:Name="txtDescriptionScenario"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource PanelBorderBrush}" />
            </StackPanel>
        </Border>

        <!--Partie Droite-->
        <Border Grid.Row="0"
                Grid.Column="2"
                CornerRadius="8"
                Padding="12"
                Background="{StaticResource PanelBorderBrush}">
            <!-- Titre -->
            <TextBlock Grid.Row="0"
                       Text="Configuration"
                       HorizontalAlignment="Center"
                       Style="{StaticResource SectionTitleStyle}" />
        </Border>

        <Border Grid.Row="2"
                Grid.Column="2"
                CornerRadius="5"
                Background="{StaticResource PanelBorderBrush}" />

        <!-- Formulaire -->
        <Border Grid.Row="4"
                Grid.Column="2"
                CornerRadius="8"
                Padding="14"
                Background="{StaticResource PanelBorderBrush}">

            <ItemsControl ItemsSource="{Binding EquipementDisponible}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal">
                            <CheckBox Content="{Binding Equipement.Nom}"
                                      IsChecked="{Binding EstSelectionne, Mode=TwoWay}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,0,20" />
                            <CheckBox Content="Allumer"
                                      IsChecked="{Binding EtatSouhaite, Mode=TwoWay}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      VerticalContentAlignment="Center"
                                      Margin="20,0,0,20">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding EstSelectionne}"
                                                               Value="True" />
                                                    <Condition Binding="{Binding EstVoletRoulant}"
                                                               Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                            <Slider Minimum="0"
                                    Maximum="100"
                                    Width="150"
                                    Margin="20,0,0,20"
                                    Value="{Binding PositionSouhaiteVoletRoulant, Mode=TwoWay}">
                                <Slider.Style>
                                    <Style TargetType="Slider">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding EstSelectionne}"
                                                               Value="True" />
                                                    <Condition Binding="{Binding EstVoletRoulant}"
                                                               Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Slider.Style>
                            </Slider>
                            <TextBlock Text="{Binding PositionSouhaiteVoletRoulant, StringFormat={}{0}%}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding EstSelectionne}"
                                                               Value="True" />
                                                    <Condition Binding="{Binding EstVoletRoulant}"
                                                               Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="5"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="btnCadncel"
                    Content="Annuler"
                    Width="100"
                    Height="25"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    Command="{Binding FermerEditeurScenarioCommand}" />
            <Button x:Name="btnEnregisctrer"
                    Content="Enregistrer"
                    Width="100"
                    Height="25"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Background="{StaticResource AccentBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Command="{Binding EnregistrerScenarioCommand}" />
        </StackPanel>

    </Grid>
</Window>